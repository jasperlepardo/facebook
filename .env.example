MONGODB_URI=
PAYLOAD_SECRET=
SESSION_SECRET=

# Display name treated as "me" in chat bubbles
NEXT_PUBLIC_OWNER_NAME=

# Cloudflare R2 (media)
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
# Client media base — falls back to R2_PUBLIC_URL if unset
NEXT_PUBLIC_R2_URL=

# WebAuthn (optional — defaults work for localhost)
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:3001

# Set true to allow open signup after the first user exists
# ALLOW_SIGNUP=false

# Optional AI story generation
# ANTHROPIC_API_KEY=

# Emergency kill switch — returns 404 for all routes
# SITE_DOWN=false
