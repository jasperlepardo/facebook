MONGODB_URI=
PAYLOAD_SECRET=
SESSION_SECRET=

# Display name treated as "me" in chat bubbles
NEXT_PUBLIC_OWNER_NAME=

# Cloudflare R2 (media)
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: custom CDN/domain only (do not use *.r2.dev — that host is rate-limited).
# Leave unset to serve via authenticated /api/media.
# NEXT_PUBLIC_R2_URL=https://media.example.com
NEXT_PUBLIC_R2_URL=

# WebAuthn (optional — defaults work for localhost)
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:3001

# Set true to allow open signup after the first user exists
# ALLOW_SIGNUP=false

# Optional AI story generation
# ANTHROPIC_API_KEY=

# Emergency kill switch — returns 404 for all routes
# SITE_DOWN=false

# Playwright authenticated smoke (local — keep in .env.local, never commit)
# E2E_EMAIL=
# E2E_PASSWORD=
# PLAYWRIGHT_BASE_URL=   # optional; defaults to local dev server
